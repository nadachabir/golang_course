# TaskFlow configuration template.
# Copy to .env (`cp .env.example .env`) and adjust. .env is git-ignored.
# These keys are read by internal/config (Viper) starting in Phase 2.

# ---- Application ----
ENV=development                 # development | production  (controls log format)
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=10s

# ---- PostgreSQL (Phase 4) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=taskflow
DB_PASSWORD=taskflow
DB_NAME=taskflow
DB_SSLMODE=disable
# Convenience DSN for the golang-migrate CLI and quick psql access:
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow?sslmode=disable

# ---- Keycloak / OIDC (Phase 7) ----
KEYCLOAK_ISSUER=http://localhost:8081/realms/taskflow
KEYCLOAK_CLIENT_ID=taskflow-api
KEYCLOAK_AUDIENCE=taskflow-api

# ---- Workflow rules ----
WORKFLOW_PATH=./workflow.yaml
